<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.phil.mall.dao.SmsFlashPromotionProductRelationDao">
    <resultMap id="flashPromotionProduct" type="com.phil.mall.dto.SmsFlashPromotionProduct"
               extends="com.phil.mall.mapper.SmsFlashPromotionProductRelationMapper.BaseResultMap">
        <result column="product_name" property="productName"/>
        <result column="product_sn" property="productSn"/>
        <result column="product_price" property="productPrice"/>
        <result column="product_pic" property="productPic"/>
        <result column="product_stock" property="productStock"/>
    </resultMap>

    <select id="getList" resultMap="flashPromotionProduct">
        SELECT
            r.*,
            p.name          product_name,
            p.product_sn    product_sn,
            p.price         product_price,
            p.pic           product_pic,
            p.stock         product_stock
        FROM
            sms_flash_promotion_product_relation r
            LEFT JOIN pms_product p ON r.product_id = p.id
        <where>
            <if test="flashPromotionId != null">
                AND r.flash_promotion_id = #{flashPromotionId}
            </if>
            <if test="flashPromotionSessionId != null">
                AND r.flash_promotion_session_id = #{flashPromotionSessionId}
            </if>
        </where>
        ORDER BY r.sort ASC
    </select>
</mapper>